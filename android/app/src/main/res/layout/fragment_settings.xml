<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#050505">

    <!-- Header -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Маршрутизация"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-medium"
        android:paddingHorizontal="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="16dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingHorizontal="16dp">

        <!-- Split tunnel card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="64dp"
            android:background="@drawable/card_glass"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp"
            android:layout_marginBottom="10dp">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Раздельное туннелирование"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Правила для приложений и сайтов"
                    android:textColor="#71717A"
                    android:textSize="12sp"/>
            </LinearLayout>
            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchSplit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:theme="@style/SwitchTheme"/>
        </LinearLayout>

        <!-- Режим правил -->
        <LinearLayout
            android:id="@+id/btnSplitMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="64dp"
            android:background="@drawable/card_glass"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:clickable="true"
            android:focusable="true"
            android:padding="16dp"
            android:layout_marginBottom="10dp">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Режим правил"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"/>
                <TextView
                    android:id="@+id/lblSplitMode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="В VPN всё, кроме списка"
                    android:textColor="#FF6B00"
                    android:textSize="12sp"/>
            </LinearLayout>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="›"
                android:textColor="#52525B"
                android:textSize="22sp"/>
        </LinearLayout>
        
        <!-- Сайты для правил -->
        <LinearLayout
            android:id="@+id/btnSites"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="64dp"
            android:background="@drawable/card_glass"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:clickable="true"
            android:focusable="true"
            android:padding="16dp"
            android:layout_marginBottom="10dp">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Сайты для правил"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"/>
                <TextView
                    android:id="@+id/lblSites"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Не задано"
                    android:textColor="#FF6B00"
                    android:textSize="12sp"/>
            </LinearLayout>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="›"
                android:textColor="#52525B"
                android:textSize="22sp"/>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Выбери приложения для правила"
            android:textColor="#71717A"
            android:textSize="13sp"
            android:paddingBottom="12dp"/>
            
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvApps"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="none"/>

    </LinearLayout>

</LinearLayout>
