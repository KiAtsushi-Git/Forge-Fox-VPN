<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/card_glass"
    android:layout_marginBottom="8dp"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvRuleType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ЗОНА"
            android:textColor="#FF6B00"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            android:background="@drawable/chip_bg"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"/>

        <TextView
            android:id="@+id/tvRuleValue"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginHorizontal="10dp"
            android:text="discord.com"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:maxLines="1"
            android:ellipsize="middle"/>

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switchRule"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:theme="@style/SwitchTheme"/>

        <ImageView
            android:id="@+id/btnDeleteRule"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="6dp"
            android:src="@android:drawable/ic_menu_delete"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Удалить правило"/>
    </LinearLayout>

    <TextView
        android:id="@+id/tvRuleHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="домен и все поддомены"
        android:textColor="#71717A"
        android:textSize="11sp"
        android:layout_marginTop="4dp"
        android:visibility="gone"/>
</LinearLayout>
