<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="SwitchTheme" parent="Theme.AppCompat.Light">
        <item name="colorControlActivated">#FF6B00</item>
    </style>
    <style name="DarkAlertDialog" parent="Theme.AppCompat.Dialog.Alert">
        <item name="android:windowBackground">@drawable/card_bg</item>
        <item name="colorAccent">#FF6B00</item>
        <item name="android:textColorPrimary">#FFFFFF</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="buttonBarPositiveButtonStyle">@style/OrangeButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/GrayButton</item>
        <item name="buttonBarNeutralButtonStyle">@style/GrayButton</item>
    </style>
    <style name="OrangeButton" parent="Widget.AppCompat.Button.ButtonBar.AlertDialog">
        <item name="android:textColor">#FF6B00</item>
    </style>
    <style name="GrayButton" parent="Widget.AppCompat.Button.ButtonBar.AlertDialog">
        <item name="android:textColor">#71717A</item>
    </style>

    <!-- Filter chip on the rules screen (mirrors the desktop rules-filter) -->
    <style name="FilterChip">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">#A1A1AA</item>
        <item name="android:background">@drawable/chip_bg</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:layout_marginEnd">6dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
</resources>
