{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ForgeFox VPN",
  "version": "1.0.1",
  "identifier": "com.forgefox.vpn-ssh",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "ForgeFox VPN",
        "width": 980,
        "height": 650,
        "minWidth": 820,
        "minHeight": 580,
        "decorations": false,
        "transparent": true,
        "center": true,
        "resizable": true
      }
    ],
    "trayIcon": {
      "iconPath": "icons/icon.ico",
      "iconAsTemplate": false,
      "tooltip": "ForgeFox VPN"
    },
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "wintun.dll"
    ]
  }
}
